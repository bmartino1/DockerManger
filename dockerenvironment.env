# ==========================================================================
# DockerManger - Default Environment
# ==========================================================================
#
# General defaults for the DockerManger container.
#
# Host-specific filesystem paths belong in compose.yaml/.env because Compose
# resolves volume mappings before the container starts.
# ==========================================================================

# --------------------------------------------------------------------------
# General
# --------------------------------------------------------------------------

TZ=America/Chicago

# Stack location INSIDE the DockerManger container.
STACKS_DIR=/opt/stacks


# --------------------------------------------------------------------------
# Web Terminal
# --------------------------------------------------------------------------

DOCKERMANGER_ENABLE_CONSOLE=true
DOCKERMANGER_TERMINAL_TYPE=xterm-256color

# Default terminal target:
#   local = shell inside the DockerManger container
DOCKERMANGER_CONSOLE_DEFAULT_TARGET=local


# --------------------------------------------------------------------------
# Optional Host SSH Console
# --------------------------------------------------------------------------
#
# DockerManger is an SSH CLIENT.
# The target host must provide and configure its own SSH server.
#
# Disabled by default so host SSH is not required to run DockerManger.
# --------------------------------------------------------------------------

DOCKERMANGER_HOST_SHELL_ENABLED=false

DOCKERMANGER_HOST_SSH_HOST=host.docker.internal
DOCKERMANGER_HOST_SSH_PORT=22
DOCKERMANGER_HOST_SSH_USER=root


# --------------------------------------------------------------------------
# SSH Key Authentication
# --------------------------------------------------------------------------
#
# Leave empty to allow OpenSSH to automatically use standard keys from:
#
#   /root/.ssh/id_ed25519
#   /root/.ssh/id_rsa
#
# Set this when a specific private key should be used, for example:
#
# DOCKERMANGER_HOST_SSH_KEY=/root/.ssh/dockermanger_host
#
# --------------------------------------------------------------------------

#DOCKERMANGER_HOST_SSH_KEY=


# --------------------------------------------------------------------------
# SSH Password Authentication
# --------------------------------------------------------------------------
#
# Optional fallback for hosts using password authentication.
#
# WARNING:
# Environment variables are not a secure secrets store.
# Prefer SSH key authentication when possible.
#
# --------------------------------------------------------------------------

#DOCKERMANGER_HOST_SSH_PASSWORD=
