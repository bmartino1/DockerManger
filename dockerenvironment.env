# ==========================================================================
# DockerManger - Default Environment
# ==========================================================================
#
# General runtime defaults for the DockerManger container.
#
# This file contains configuration consumed INSIDE DockerManger.
#
# Host-specific Compose settings such as published ports and host filesystem
# paths should remain in compose.yaml or a Compose .env file.
#
# ==========================================================================


# --------------------------------------------------------------------------
# General
# --------------------------------------------------------------------------

# Container/application timezone.
TZ=America/Chicago

# Stack location INSIDE the DockerManger container.
STACKS_DIR=/opt/stacks


# --------------------------------------------------------------------------
# Web / HTTPS
# --------------------------------------------------------------------------
#
# DockerManger prefers HTTPS for normal browser access.
#
# When enabled, HTTP requests are redirected to the HTTPS interface.
#
# A fresh installation may initially use a DockerManger-generated self-signed
# certificate. Deployments with a suitable DNS name may later use Certbot /
# Let's Encrypt or provide their own certificate.
#
# Reverse-proxy deployments may choose to disable DockerManger's direct HTTPS
# handling and terminate TLS at the reverse proxy instead.
#

DOCKERMANGER_HTTPS_ENABLED=true

# DOCKERMANGER_HTTPS_PORT is intentionally NOT defined here.
#
# compose.yaml supplies it from:
#
#   WEB_HTTPS_PORT
#
# because it represents the externally published HTTPS port rather than an
# internal DockerManger runtime default.


# --------------------------------------------------------------------------
# Web Terminal
# --------------------------------------------------------------------------
#
# Enables the future DockerManger WebTTY/xterm.js console subsystem.
#

DOCKERMANGER_ENABLE_CONSOLE=true

# Terminal type presented to interactive shells.
DOCKERMANGER_TERMINAL_TYPE=xterm-256color

# Default console target:
#
#   local = shell inside the DockerManger container
#
DOCKERMANGER_CONSOLE_DEFAULT_TARGET=local


# --------------------------------------------------------------------------
# Optional Host SSH Console
# --------------------------------------------------------------------------
#
# DockerManger is an SSH CLIENT only.
#
# The target Docker / Linux / Proxmox host must provide, configure and secure
# its own SSH server.
#
# Host SSH access is disabled by default so it is never required simply to
# install or operate DockerManger.
#

DOCKERMANGER_HOST_SHELL_ENABLED=false

DOCKERMANGER_HOST_SSH_HOST=host.docker.internal
DOCKERMANGER_HOST_SSH_PORT=22
DOCKERMANGER_HOST_SSH_USER=root


# --------------------------------------------------------------------------
# SSH Key Authentication
# --------------------------------------------------------------------------
#
# Persistent SSH client files live beneath:
#
#   /data/ssh
#
# The container entrypoint exposes that directory to OpenSSH as /root/.ssh.
# OpenSSH automatically checks standard private-key locations including:
#
#   /root/.ssh/id_ed25519
#   /root/.ssh/id_rsa
#
# Therefore this setting can normally remain empty.
#
# To force DockerManger to use a specific/dedicated key, set:
#
#   DOCKERMANGER_HOST_SSH_KEY=/root/.ssh/dockermanger_host
#

DOCKERMANGER_HOST_SSH_KEY=

# --------------------------------------------------------------------------
# SSH Password Authentication
# --------------------------------------------------------------------------
#
# Optional fallback for hosts using SSH password authentication.
#
# Leave empty when password authentication is not required.
#
# WARNING:
# Environment variables are not a secure secrets store and may be visible
# through Docker/container inspection.
#
# SSH key authentication should be preferred when practical.
#

DOCKERMANGER_HOST_SSH_PASSWORD=
